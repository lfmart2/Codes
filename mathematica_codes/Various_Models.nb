Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
   "Wilson", " ", "Loop", " ", "around", " ", "kx", " ", "for", " ", 
    "several", " ", "values", " ", "of", " ", "ky"}], "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"\[Alpha]1", " ", "=", " ", 
     RowBox[{"-", "1.5"}]}], ";", " ", 
    RowBox[{"\[Beta]1", " ", "=", " ", "0"}], ";", " ", 
    RowBox[{"\[Gamma]1", " ", "=", " ", "0"}], ";", " ", 
    RowBox[{"NN", " ", "=", " ", "1000"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"\[Alpha]2", " ", "=", " ", 
     RowBox[{"-", "1.5"}]}], ";", " ", 
    RowBox[{"\[Beta]2", " ", "=", " ", "1.5"}], ";", " ", 
    RowBox[{"\[Gamma]2", " ", "=", " ", "1"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"kkx", " ", "=", " ", 
     RowBox[{"Subdivide", "[", 
      RowBox[{"0", ",", 
       RowBox[{"2", "*", "Pi"}], ",", " ", "NN"}], "]"}]}], ";", " ", 
    RowBox[{"kky", " ", "=", " ", 
     RowBox[{"Subdivide", "[", 
      RowBox[{
       RowBox[{"-", "Pi"}], ",", "Pi", ",", " ", "250"}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"wlp1", " ", "=", 
     RowBox[{"ConstantArray", "[", 
      RowBox[{"1", ",", 
       RowBox[{"Length", "[", "kky", "]"}]}], "]"}]}], ";", " ", 
    RowBox[{"wlp2", " ", "=", " ", 
     RowBox[{"ConstantArray", "[", 
      RowBox[{"1", ",", 
       RowBox[{"Length", "[", "kky", "]"}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{"For", "[", 
    RowBox[{
     RowBox[{"q", "=", "1"}], ",", " ", 
     RowBox[{"q", "<=", 
      RowBox[{"Length", "[", "kky", "]"}]}], ",", 
     RowBox[{"q", "++"}], ",", "\[IndentingNewLine]", "\t", 
     RowBox[{"For", "[", 
      RowBox[{
       RowBox[{"qq", "=", "2"}], ",", 
       RowBox[{"qq", "<=", "NN"}], ",", 
       RowBox[{"qq", "++"}], ",", "\[IndentingNewLine]", "\t", 
       RowBox[{
        RowBox[{
         RowBox[{"{", 
          RowBox[{"eigs", ",", "vecs"}], "}"}], "=", 
         RowBox[{"Eigensystem", "[", 
          RowBox[{"h", "[", 
           RowBox[{
            RowBox[{"kkx", "[", 
             RowBox[{"[", "qq", "]"}], "]"}], ",", 
            RowBox[{"kky", "[", 
             RowBox[{"[", "q", "]"}], "]"}], ",", "\[Alpha]1", ",", 
            "\[Beta]1", ",", "\[Gamma]1"}], "]"}], "]"}]}], ";", 
        "\[IndentingNewLine]", "\t", 
        RowBox[{"list1", "=", 
         RowBox[{"Partition", "[", 
          RowBox[{
           RowBox[{"Riffle", "[", 
            RowBox[{"eigs", ",", "vecs"}], "]"}], ",", "2"}], "]"}]}], ";", 
        "\[IndentingNewLine]", "\t", 
        RowBox[{"list2", "=", 
         RowBox[{"Sort", "[", 
          RowBox[{"list1", ",", 
           RowBox[{
            RowBox[{
             RowBox[{"#1", "[", 
              RowBox[{"[", "1", "]"}], "]"}], "<", 
             RowBox[{"#2", "[", 
              RowBox[{"[", "1", "]"}], "]"}]}], "&"}]}], "]"}]}], ";", 
        "\[IndentingNewLine]", "\[IndentingNewLine]", "\t", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"eigs1", ",", "vecs1"}], "}"}], "=", 
         RowBox[{"Eigensystem", "[", 
          RowBox[{"h", "[", 
           RowBox[{
            RowBox[{"kkx", "[", 
             RowBox[{"[", 
              RowBox[{"qq", "-", "1"}], "]"}], "]"}], ",", 
            RowBox[{"kky", "[", 
             RowBox[{"[", "q", "]"}], "]"}], ",", "\[Alpha]1", ",", 
            "\[Beta]1", ",", "\[Gamma]1"}], "]"}], "]"}]}], ";", 
        "\[IndentingNewLine]", "\t", 
        RowBox[{"list11", "=", 
         RowBox[{"Partition", "[", 
          RowBox[{
           RowBox[{"Riffle", "[", 
            RowBox[{"eigs1", ",", "vecs1"}], "]"}], ",", "2"}], "]"}]}], ";", 
        "\[IndentingNewLine]", "\t", 
        RowBox[{"list22", "=", 
         RowBox[{"Sort", "[", 
          RowBox[{"list11", ",", 
           RowBox[{
            RowBox[{
             RowBox[{"#1", "[", 
              RowBox[{"[", "1", "]"}], "]"}], "<", 
             RowBox[{"#2", "[", 
              RowBox[{"[", "1", "]"}], "]"}]}], "&"}]}], "]"}]}], ";", 
        "\[IndentingNewLine]", "\[IndentingNewLine]", "\t", 
        RowBox[{
         RowBox[{"wlp1", "[", 
          RowBox[{"[", "q", "]"}], "]"}], " ", "=", " ", 
         RowBox[{
          RowBox[{"wlp1", "[", 
           RowBox[{"[", "q", "]"}], "]"}], "*", 
          RowBox[{
           RowBox[{"list2", "[", 
            RowBox[{"[", 
             RowBox[{"1", ",", "2"}], "]"}], "]"}], ".", 
           RowBox[{"list22", "[", 
            RowBox[{"[", 
             RowBox[{"1", ",", "2"}], "]"}], "]"}]}]}]}], " ", ";", 
        "\[IndentingNewLine]", "\t", 
        RowBox[{
         RowBox[{"wlp2", "[", 
          RowBox[{"[", "q", "]"}], "]"}], "=", " ", 
         RowBox[{
          RowBox[{"wlp2", "[", 
           RowBox[{"[", "q", "]"}], "]"}], "*", 
          RowBox[{
           RowBox[{"list2", "[", 
            RowBox[{"[", 
             RowBox[{"2", ",", "2"}], "]"}], "]"}], ".", 
           RowBox[{"list22", "[", 
            RowBox[{"[", 
             RowBox[{"2", ",", "2"}], "]"}], "]"}]}]}]}]}]}], 
      "\[IndentingNewLine]", "]"}]}], "\[IndentingNewLine]", 
    "]"}]}]}]], "Input",
