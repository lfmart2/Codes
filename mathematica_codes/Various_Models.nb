Cell[BoxData[
 RowBox[{
  RowBox[{"HObhz", "[", 
   RowBox[{
   "ky_", ",", "\[Epsilon]s_", ",", "\[Epsilon]p_", ",", "tss_", ",", "tpp_", 
    ",", "tsp_", ",", "NN_", ",", "m_"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"h0", ",", "hp", ",", "t0", ",", "tp", ",", "Tp", ",", "T0"}], 
     "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"t0", "=", 
      RowBox[{"ConstantArray", "[", 
       RowBox[{"0", ",", 
        RowBox[{"{", 
         RowBox[{"NN", ",", "NN"}], "}"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"tp", "=", 
      RowBox[{"ConstantArray", "[", 
       RowBox[{"0", ",", 
        RowBox[{"{", 
         RowBox[{"NN", ",", "NN"}], "}"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"For", "[", 
      RowBox[{
       RowBox[{"i", "=", "1"}], ",", 
       RowBox[{"i", "<=", "NN"}], ",", 
       RowBox[{"i", "++"}], ",", 
       RowBox[{
        RowBox[{
         RowBox[{"t0", "[", 
          RowBox[{"[", 
           RowBox[{"i", ",", "i"}], "]"}], "]"}], "=", "1"}], ";"}]}], "]"}], 
     ";", "\[IndentingNewLine]", 
     RowBox[{"For", "[", 
      RowBox[{
       RowBox[{"i", "=", "1"}], ",", 
       RowBox[{"i", "<=", 
        RowBox[{"NN", "-", "1"}]}], ",", 
       RowBox[{"i", "++"}], ",", 
       RowBox[{
        RowBox[{
         RowBox[{"tp", "[", 
          RowBox[{"[", 
           RowBox[{"i", ",", 
            RowBox[{"i", "+", "1"}]}], "]"}], "]"}], "=", "1"}], ";"}]}], 
      "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"h0", "=", 
      RowBox[{"N", "[", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"\[Epsilon]s", "-", 
            RowBox[{"2", "*", "tss", "*", 
             RowBox[{"Cos", "[", "ky", "]"}]}], "+", "m"}], ",", 
           RowBox[{"2", "*", "tsp", "*", 
            RowBox[{"Sin", "[", "ky", "]"}]}], ",", "0", ",", "0"}], "}"}], 
         ",", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"2", "*", "tsp", "*", 
            RowBox[{"Sin", "[", "ky", "]"}]}], ",", 
           RowBox[{"\[Epsilon]p", "+", 
            RowBox[{"2", "*", "tpp", "*", 
             RowBox[{"Cos", "[", "ky", "]"}]}], "-", "m"}], ",", "0", ",", 
           "0"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"0", ",", "0", ",", 
           RowBox[{"\[Epsilon]s", "-", 
            RowBox[{"2", "*", "tss", "*", 
             RowBox[{"Cos", "[", "ky", "]"}]}], "-", "m"}], ",", 
           RowBox[{
            RowBox[{"-", "2"}], "*", "tsp", "*", 
            RowBox[{"Sin", "[", "ky", "]"}]}]}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"0", ",", "0", ",", 
           RowBox[{
            RowBox[{"-", "2"}], "*", "tsp", "*", 
            RowBox[{"Sin", "[", "ky", "]"}]}], ",", 
           RowBox[{"\[Epsilon]p", "+", 
            RowBox[{"2", "*", "tpp", "*", 
             RowBox[{"Cos", "[", "ky", "]"}]}], "+", "m"}]}], "}"}]}], "}"}], 
       "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"hp", "=", 
      RowBox[{"N", "[", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"-", "tss"}], ",", "tsp", ",", "0", ",", "0"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"-", "tsp"}], ",", "tpp", ",", "0", ",", "0"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"0", ",", "0", ",", 
           RowBox[{"-", "tss"}], ",", "tsp"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"0", ",", "0", ",", 
           RowBox[{"-", "tsp"}], ",", "tpp"}], "}"}]}], "}"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Tp", " ", "=", " ", 
      RowBox[{
       RowBox[{"KroneckerProduct", "[", 
        RowBox[{"tp", ",", "hp"}], "]"}], "+", 
       RowBox[{"ConjugateTranspose", "[", 
        RowBox[{"KroneckerProduct", "[", 
         RowBox[{"tp", ",", "hp"}], "]"}], "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"T0", " ", "=", "  ", 
      RowBox[{"KroneckerProduct", "[", 
