     RowBox[{"{", 
      RowBox[{"ki", ",", "1", ",", "Nk"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"kj", ",", "1", ",", "Nk"}], "}"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Wilson", "=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"ConjugateTranspose", "[", 
       RowBox[{"uk", "[", 
        RowBox[{"[", 
         RowBox[{"1", ",", "kj"}], "]"}], "]"}], "]"}], ".", 
      RowBox[{"(", 
       RowBox[{"Dot", "@@", 
        RowBox[{"Pk", "[", 
