      RowBox[{"uk", "[", 
       RowBox[{"[", 
        RowBox[{"1", ",", "kj"}], "]"}], "]"}]}], ",", 
     RowBox[{"{", 
      RowBox[{"kj", ",", "1", ",", "Nk"}], "}"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
