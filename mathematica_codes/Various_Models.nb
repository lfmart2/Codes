Cell[BoxData[
 RowBox[{
  RowBox[{"hx", "[", 
   RowBox[{"ky_", ",", "N_", ",", "m_"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "\[Sigma]x", ",", "\[Sigma]y", ",", "\[Sigma]z", ",", "h0", ",", "t0", 
      ",", "th", ",", "T0", ",", "Th"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"\[Sigma]x", "=", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"0", ",", "1"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"1", ",", "0"}], "}"}]}], "}"}]}], ";", " ", 
     RowBox[{"\[Sigma]y", "=", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"0", ",", 
          RowBox[{"-", "\[ImaginaryI]"}]}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"\[ImaginaryI]", ",", "0"}], "}"}]}], "}"}]}], ";", " ", 
     RowBox[{"\[Sigma]z", "=", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"1", ",", "0"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"0", ",", 
          RowBox[{"-", "1"}]}], "}"}]}], "}"}]}], ";", "\[IndentingNewLine]", 
     
     RowBox[{"t0", "=", 
      RowBox[{"ConstantArray", "[", 
       RowBox[{"0", ",", 
        RowBox[{"{", 
         RowBox[{"N", ",", "N"}], "}"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"th", "=", 
      RowBox[{"ConstantArray", "[", 
       RowBox[{"0", ",", 
        RowBox[{"{", 
         RowBox[{"N", ",", "N"}], "}"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"For", "[", 
      RowBox[{
       RowBox[{"i", "=", "1"}], ",", 
       RowBox[{"i", "<=", "N"}], ",", 
       RowBox[{"i", "++"}], ",", 
       RowBox[{
        RowBox[{
         RowBox[{"t0", "[", 
          RowBox[{"[", 
           RowBox[{"i", ",", "i"}], "]"}], "]"}], "=", "1"}], ";"}]}], "]"}], 
     ";", "\[IndentingNewLine]", 
     RowBox[{"For", "[", 
      RowBox[{
       RowBox[{"i", "=", "1"}], ",", 
       RowBox[{"i", "<=", 
        RowBox[{"N", "-", "1"}]}], ",", 
       RowBox[{"i", "++"}], ",", 
       RowBox[{
        RowBox[{
         RowBox[{"th", "[", 
          RowBox[{"[", 
           RowBox[{"i", ",", 
            RowBox[{"i", "+", "1"}]}], "]"}], "]"}], "=", "1"}], ";"}]}], 
      "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"Th", "=", 
      RowBox[{
       RowBox[{"KroneckerProduct", "[", 
        RowBox[{"th", ",", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{"\[Sigma]z", "+", 
            RowBox[{"\[ImaginaryI]", "*", "\[Sigma]x"}]}], ")"}], "/", 
          "2"}]}], "]"}], "+", 
       RowBox[{"ConjugateTranspose", "[", 
        RowBox[{"KroneckerProduct", "[", 
         RowBox[{"th", ",", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{"\[Sigma]z", "+", 
             RowBox[{"\[ImaginaryI]", "*", "\[Sigma]x"}]}], ")"}], "/", 
           "2"}]}], "]"}], "]"}]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"T0", "=", " ", 
      RowBox[{"KroneckerProduct", "[", 
       RowBox[{"t0", ",", 
        RowBox[{
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            RowBox[{"Cos", "[", "ky", "]"}], "+", "m"}], ")"}], "*", 
          "\[Sigma]z"}], "+", 
         RowBox[{
          RowBox[{"Sin", "[", "ky", "]"}], "*", "\[Sigma]y"}]}]}], "]"}]}], 
     ";", "\[IndentingNewLine]", 
     RowBox[{"T0", "+", "Th"}]}]}], "\[IndentingNewLine]", "]"}]}]], "Input",
 CellChangeTimes->{{3.876564431608794*^9, 3.8765644463048363`*^9}, {
  3.876571816619606*^9, 3.876571842861909*^9}, {3.876571877455944*^9, 
  3.876572085305257*^9}, {3.876572143233943*^9, 3.876572148458056*^9}, {
