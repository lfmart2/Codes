Cell[CellGroupData[{

Cell["Assignment 3", "Subtitle",
 CellChangeTimes->{{3.876235392813657*^9, 
  3.876235417869928*^9}},ExpressionUUID->"34b9fb9c-bd94-4bf9-a854-\
106e03177e5b"],

Cell[BoxData[
 RowBox[{
  RowBox[{"h2", "[", 
   RowBox[{"kx_", ",", "ky_", ",", "t_", ",", "t1_", ",", "\[Lambda]_"}], 
   "]"}], ":=", " ", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"\[Alpha]1", ",", "\[Alpha]2", ",", "\[Alpha]3", ",", "k"}], 
     "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{"(*", " ", "Vectors", " ", "*)"}], "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"\[Alpha]1", "=", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"N", "[", 
         RowBox[{"2", "*", "\[Lambda]"}], "]"}], ",", "0"}], "}"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"\[Alpha]2", "=", 
      RowBox[{"{", 
       RowBox[{"\[Lambda]", ",", 
        RowBox[{
         RowBox[{"N", "[", 
          RowBox[{"Sqrt", "[", "3", "]"}], "]"}], "*", "\[Lambda]"}]}], 
       "}"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"\[Alpha]3", "=", 
      RowBox[{"{", 
       RowBox[{"\[Lambda]", ",", 
        RowBox[{
         RowBox[{"-", 
          RowBox[{"N", "[", 
           RowBox[{"Sqrt", "[", "3", "]"}], "]"}]}], "*", "\[Lambda]"}]}], 
       "}"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"k", "=", 
      RowBox[{"{", 
       RowBox[{"kx", ",", "ky"}], "}"}]}], ";", "\[IndentingNewLine]", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", " ", "Hamiltonian", " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"N", "[", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"0", ",", "t", ",", "0", ",", 
          RowBox[{"t1", "*", 
           RowBox[{"Exp", "[", 
            RowBox[{
             RowBox[{"-", "\[ImaginaryI]"}], "*", 
             RowBox[{"k", ".", "\[Alpha]3"}]}], "]"}]}], ",", "0", ",", "t"}],
          "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"t", ",", "0", ",", "t", ",", "0", ",", 
          RowBox[{"t1", "*", 
           RowBox[{"Exp", "[", 
            RowBox[{"\[ImaginaryI]", "*", 
             RowBox[{"k", ".", "\[Alpha]2"}]}], "]"}]}], ",", "0"}], "}"}], 
        ",", 
        RowBox[{"{", 
         RowBox[{"0", ",", "t", ",", "0", ",", "t", ",", "0", ",", 
          RowBox[{"t1", "*", 
           RowBox[{"Exp", "[", 
            RowBox[{"\[ImaginaryI]", "*", 
             RowBox[{"k", ".", "\[Alpha]1"}]}], "]"}]}]}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"t1", "*", 
           RowBox[{"Exp", "[", 
            RowBox[{"\[ImaginaryI]", "*", 
             RowBox[{"k", ".", "\[Alpha]3"}]}], "]"}]}], ",", "0", ",", "t", 
          ",", "0", ",", "t", ",", "0"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"0", ",", 
          RowBox[{"t1", "*", 
           RowBox[{"Exp", "[", 
            RowBox[{
             RowBox[{"-", "\[ImaginaryI]"}], "*", 
             RowBox[{"k", ".", "\[Alpha]2"}]}], "]"}]}], ",", "0", ",", "t", 
          ",", "0", ",", "t"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"t", ",", "0", ",", 
          RowBox[{"t1", "*", 
           RowBox[{"Exp", "[", 
            RowBox[{
             RowBox[{"-", "\[ImaginaryI]"}], "*", 
             RowBox[{"k", ".", "\[Alpha]1"}]}], "]"}]}], ",", "0", ",", "t", 
          ",", "0"}], "}"}]}], "}"}], "]"}]}]}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", "]"}]}]], "Input",
