              RowBox[{"kv", "[", 
               RowBox[{"[", "kj", "]"}], "]"}], ",", "\[Epsilon]s", ",", 
              "\[Epsilon]p", ",", "t", ",", "t", ",", "tsp", ",", "m"}], 
