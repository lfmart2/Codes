     RowBox[{"{", 
      RowBox[{"kj", ",", "1", ",", "Nk"}], "}"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Pk", "=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"uk", "[", 
       RowBox[{"[", 
        RowBox[{"ki", ",", "kj"}], "]"}], "]"}], ".", 
      RowBox[{"ConjugateTranspose", "[", 
       RowBox[{"uk", "[", 
