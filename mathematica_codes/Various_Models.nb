   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"N", "[", "i", "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"i", ",", "0", ",", 
       RowBox[{
        RowBox[{"2", "\[Pi]"}], "-", 
        RowBox[{"2", 
         RowBox[{"\[Pi]", "/", "Nk"}]}]}], ",", 
       RowBox[{"2", 
        RowBox[{"\[Pi]", "/", "Nk"}]}]}], "}"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"uk", "=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"Transpose", "[", 
      RowBox[{
       RowBox[{"Transpose", "[", 
        RowBox[{"SortBy", "[", 
         RowBox[{
          RowBox[{"Transpose", "[", 
           RowBox[{"Eigensystem", "[", 
            RowBox[{"Hbhz", "[", 
